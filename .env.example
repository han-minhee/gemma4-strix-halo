# Set these from inspected the inference host state and measured results, before deployment.
HALO_IMAGE=sha256:REPLACE_WITH_TESTED_LOCAL_IMAGE_ID
RENDER_GID=REPLACE_WITH_HOST_RENDER_GROUP_GID
API_KEY_FILE=/srv/amd-halo/secrets/api-key
HALO_PORT=8080
MODEL_FILE=gemma-4-31B-it-Q4_K_M.gguf
GPU_LAYERS=999
THREADS=2
THREADS_BATCH=2
CONTEXT=8192
PARALLEL=1
BATCH=2048
UBATCH=512
FLASH_ATTN=on
CACHE_K=f16
CACHE_V=f16
LOAD_MODE=none
# Needed only for the HIP overlay. Preserve the absolute SDK installation path.
ROCM_LIBRARY_PATH=/srv/amd-halo/rocm-venv/lib/python3.14/site-packages/_rocm_sdk_devel/lib
# Needed for the MTP overlay. Four drafts won the the inference host HTTP comparison.
DRAFT_TOKENS=4
DRAFT_P_MIN=0
SPEC_TYPE=draft-mtp
DRAFT_FILE=mtp-gemma-4-31B-it-Q8_0.gguf
